  autoEmail  Boolean  @default(true)
  message    String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model PlatformSetting {
  key       String   @id
  intValue  Int?
  textValue String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
