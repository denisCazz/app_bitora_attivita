generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MembershipStatus {
  ACTIVE
  INVITED
  SUSPENDED
}

enum CustomFieldType {
  TEXT
  NUMBER
  DATE
  SELECT
  PHOTO
}

enum CustomFieldEntity {
  CUSTOMER
  ASSET
  WORK_ORDER
  PRODUCT
}

enum WorkOrderStatus {
  DRAFT
  SCHEDULED
  IN_PROGRESS
  DONE
  CANCELLED
}

enum StockLocationKind {
  WAREHOUSE
  MOBILE
  POINT
}

enum OrderStatus {
  OPEN
  SENT
  PARTIAL
  CLOSED
  VOID
}

enum OrderLineStatus {
  PENDING
  SENT
  READY
  SERVED
  VOID
}

enum PurchaseOrderStatus {
  DRAFT
  SENT
  RECEIVED
  CANCELLED
}

enum ShiftStatus {
  PLANNED
  CONFIRMED
  DONE
  CANCELLED
}

enum BillingSource {
  STRIPE
  APPLE
  GOOGLE
  DEMO
}

enum StorePlatform {
  APPLE
  GOOGLE
}

enum LedgerKind {
  INCOME
  EXPENSE
}

enum WorkPaymentStatus {
  DUE
  PARTIAL
  PAID
  CANCELLED
}

model User {
  id                String           @id @default(cuid())
  email             String           @unique
  name              String
  /// Null for accounts created with Apple or Google.
  passwordHash      String?
  appleSub          String?          @unique
  /// Needed to revoke Sign in with Apple when the account is deleted (App Store rule 5.1.1).
  appleRefreshToken String?
  googleSub         String?          @unique
  activeTenantId    String?
  platformAdmin     Boolean          @default(false)
  termsVersion      String?
  termsAcceptedAt   DateTime?
  aiConsentAt       DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  memberships       Membership[]
  refreshTokens     RefreshToken[]
  pushTokens        PushToken[]
  shifts            Shift[]
  assignedOrders    WorkOrder[]      @relation("Assignee")
  payrollPostings   PayrollPosting[]
}

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model PushToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String
  platform  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, token])
  @@index([userId])
}

model Tenant {
  id                        String              @id @default(cuid())
  name                      String
  categoryId                String
  category                  Category            @relation(fields: [categoryId], references: [id])
  needs                     String[]            @default([])
  settings                  Json                @default("{}")
  branding                  Json                @default("{}")
  stripeCustomerId          String?             @unique
  extraSeats                Int                 @default(0)
  seatsStripeSubscriptionId String?
  storeAccountToken         String              @unique @default(dbgenerated("(gen_random_uuid())::text"))
  createdAt                 DateTime            @default(now())
  updatedAt                 DateTime            @updatedAt
  locations                 Location[]
  memberships               Membership[]
  roles                     Role[]
  modules                   TenantModule[]
  customFields              CustomFieldDef[]
  customers                 Customer[]
  assets                    Asset[]
  workOrders                WorkOrder[]
  checklists                ChecklistTemplate[]
  checklistRuns             ChecklistRun[]
  attachments               Attachment[]
  schedules                 Schedule[]
  spareParts                SparePart[]
  stockLocations            StockLocation[]
  stockMovements            StockMovement[]
  tables                    DiningTable[]
  menuItems                 MenuItem[]
  modifiers                 Modifier[]
  menuItemModifiers         MenuItemModifier[]
  orders                    Order[]
  orderLines                OrderLine[]
  ingredients               Ingredient[]
  suppliers                 Supplier[]
  purchaseOrders            PurchaseOrder[]
  purchaseOrderLines        PurchaseOrderLine[]
  shifts                    Shift[]
  ledgerEntries             LedgerEntry[]
  payrollPostings           PayrollPosting[]
  workOrderPayments         WorkOrderPayment[]
  invites                   Invite[]
  notifications             Notification[]
  storePurchases            StorePurchase[]

  @@index([categoryId])
  @@index([seatsStripeSubscriptionId])
}

model Category {
  id          String           @id @default(cuid())
  key         String           @unique
  parentId    String?
  parent      Category?        @relation("CategoryTree", fields: [parentId], references: [id])
  children    Category[]       @relation("CategoryTree")
  label       String
  description String           @default("")
  icon        String           @default("apps-outline")
  accent      String?
  image       String?
  terminology Json             @default("{}")
  presets     Json             @default("{}")
  sortOrder   Int              @default(0)
  active      Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  modules     CategoryModule[]
  roles       CategoryRole[]
  needs       Need[]
  tenants     Tenant[]

  @@index([parentId])
}

model Need {
  id          String    @id @default(cuid())
  key         String    @unique
  categoryId  String?
  category    Category? @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  label       String
  description String    @default("")
  icon        String    @default("checkmark-circle-outline")
  modules     String[]
  sortOrder   Int       @default(0)
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([categoryId])
}

model ModuleDef {
  key             String           @id
  label           String
  description     String           @default("")
  pitch           String           @default("")
  details         String           @default("")
  features        String[]         @default([])
  icon            String           @default("apps-outline")
  priceCents      Int              @default(0)
  trialDays       Int              @default(14)
  requires        String[]         @default([])
  sortOrder       Int              @default(0)
  active          Boolean          @default(true)
  stripeProductId String?          @unique
  stripePriceId   String?          @unique
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  categories      CategoryModule[]
}

model CategoryModule {
  id          String    @id @default(cuid())
  categoryId  String
  category    Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  moduleKey   String
  module      ModuleDef @relation(fields: [moduleKey], references: [key], onDelete: Cascade)
  included    Boolean   @default(true)
  recommended Boolean?
  free        Boolean?
  tab         Boolean?
  sortOrder   Int?
  label       String?
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([categoryId, moduleKey])
  @@index([moduleKey])
}

model CategoryRole {
  id          String   @id @default(cuid())
  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  name        String
  owner       Boolean  @default(false)
  permissions String[]
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([categoryId, name])
}

model Location {
  id        String        @id @default(cuid())
  tenantId  String
  tenant    Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  address   String?
  city      String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  assets    Asset[]
  tables    DiningTable[]

  @@index([tenantId])
}

model Role {
  id          String       @id @default(cuid())
  tenantId    String
  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String
  permissions String[]
  isSystem    Boolean      @default(false)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  memberships Membership[]
  invites     Invite[]

  @@unique([tenantId, name])
  @@index([tenantId])
}

model Membership {
  id           String           @id @default(cuid())
  userId       String
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenantId     String
  tenant       Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  roleId       String
  role         Role             @relation(fields: [roleId], references: [id])
  status       MembershipStatus @default(ACTIVE)
  /// Ordinary hourly wage. Null means this person is not on payroll.
  hourlyRate   Decimal?         @db.Decimal(8, 2)
  overtimeRate Decimal?         @db.Decimal(8, 2)
  /// Hours per Monday–Sunday week paid at the ordinary rate. The rest is overtime.
  weeklyHours  Decimal          @default(40) @db.Decimal(5, 2)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@unique([userId, tenantId])
  @@index([tenantId])
  @@index([userId])
}

model Invite {
  id         String    @id @default(cuid())
  tenantId   String
  tenant     Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  email      String
  roleId     String
  role       Role      @relation(fields: [roleId], references: [id])
  token      String    @unique
  expiresAt  DateTime
  acceptedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([tenantId, email])
}

model TenantModule {
  id                   String         @id @default(cuid())
  tenantId             String
  tenant               Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  moduleKey            String
  enabled              Boolean        @default(true)
  config               Json           @default("{}")
  licensed             Boolean        @default(false)
  billingSource        BillingSource?
  licenseExpiresAt     DateTime?
  trialEndsAt          DateTime?
  stripeSubscriptionId String?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  @@unique([tenantId, moduleKey])
  @@index([stripeSubscriptionId])
  @@index([tenantId])
}

model StorePurchase {
  id           String        @id @default(cuid())
  tenantId     String
  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  platform     StorePlatform
  purchaseKey  String
  productId    String
  moduleKey    String
  environment  String
  active       Boolean       @default(false)
  autoRenewing Boolean       @default(false)
  expiresAt    DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@unique([platform, purchaseKey])
  @@index([tenantId, moduleKey])
}

model CustomFieldDef {
  id        String            @id @default(cuid())
  tenantId  String
  tenant    Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  entity    CustomFieldEntity
  key       String
  label     String
  type      CustomFieldType
  required  Boolean           @default(false)
  options   Json              @default("[]")
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@unique([tenantId, entity, key])
  @@index([tenantId, entity])
}

model Customer {
  id            String             @id @default(cuid())
  tenantId      String
  tenant        Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name          String
  phone         String?
  email         String?
  address       String?
  city          String?
  notes         String?
  customFields  Json               @default("{}")
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  assets        Asset[]
  workOrders    WorkOrder[]
  ledgerEntries LedgerEntry[]
  payments      WorkOrderPayment[]

  @@index([tenantId, name])
}

model Asset {
  id           String      @id @default(cuid())
  tenantId     String
  tenant       Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customerId   String?
  customer     Customer?   @relation(fields: [customerId], references: [id])
  locationId   String?
  location     Location?   @relation(fields: [locationId], references: [id])
  type         String?
  name         String
  brand        String?
  model        String?
  serialNumber String?
  installedAt  DateTime?
  notes        String?
  customFields Json        @default("{}")
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  workOrders   WorkOrder[]
  schedules    Schedule[]

  @@index([tenantId])
  @@index([tenantId, serialNumber])
  @@index([customerId])
}

model WorkOrder {
  id                  String            @id @default(cuid())
  tenantId            String
  tenant              Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customerId          String?
  customer            Customer?         @relation(fields: [customerId], references: [id])
  assetId             String?
  asset               Asset?            @relation(fields: [assetId], references: [id])
  assigneeId          String?
  assignee            User?             @relation("Assignee", fields: [assigneeId], references: [id])
  title               String
  description         String?
  status              WorkOrderStatus   @default(DRAFT)
  scheduledAt         DateTime?
  durationMinutes     Int?
  completedAt         DateTime?
  signatureData       String?
  signedBy            String?
  technicianSignature String?
  technicianSignedBy  String?
  technicianSignedAt  DateTime?
  customFields        Json              @default("{}")
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  checklistRuns       ChecklistRun[]
  attachments         Attachment[]
  stockMovements      StockMovement[]
  ledgerEntries       LedgerEntry[]
  payment             WorkOrderPayment?

  @@index([tenantId, status])
  @@index([tenantId, scheduledAt])
}

model ChecklistTemplate {
  id        String         @id @default(cuid())
  tenantId  String
  tenant    Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  kind      String         @default("GENERIC")
  items     Json
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  runs      ChecklistRun[]
  schedules Schedule[]

  @@index([tenantId])
}

model ChecklistRun {
  id          String             @id @default(cuid())
  tenantId    String
  tenant      Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  templateId  String?
  template    ChecklistTemplate? @relation(fields: [templateId], references: [id])
  workOrderId String?
  workOrder   WorkOrder?         @relation(fields: [workOrderId], references: [id])
  assetId     String?
  answers     Json
  completedAt DateTime?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@index([tenantId])
  @@index([workOrderId])
}

model Attachment {
  id          String     @id @default(cuid())
  tenantId    String
  tenant      Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  workOrderId String?
  workOrder   WorkOrder? @relation(fields: [workOrderId], references: [id])
  fileName    String
  mimeType    String
  url         String
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([tenantId])
  @@index([workOrderId])
}

model Schedule {
  id              String             @id @default(cuid())
  tenantId        String
  tenant          Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  assetId         String?
  asset           Asset?             @relation(fields: [assetId], references: [id])
  templateId      String?
  template        ChecklistTemplate? @relation(fields: [templateId], references: [id])
  kind            String
  title           String
  dueAt           DateTime
  durationMinutes Int?
  intervalMonths  Int?
  lastRemindedAt  DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@index([tenantId, dueAt])
}

model SparePart {
  id               String          @id @default(cuid())
  tenantId         String
  tenant           Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sku              String
  name             String
  brand            String?
  compatibleModels String[]
  barcode          String?
  unitPrice        Decimal         @default(0) @db.Decimal(10, 2)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  movements        StockMovement[]

  @@unique([tenantId, sku])
  @@index([tenantId])
  @@index([tenantId, barcode])
}

model StockLocation {
  id        String            @id @default(cuid())
  tenantId  String
  tenant    Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  kind      StockLocationKind
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  movements StockMovement[]

  @@index([tenantId, kind])
}

model StockMovement {
  id           String        @id @default(cuid())
  tenantId     String
  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  partId       String?
  part         SparePart?    @relation(fields: [partId], references: [id])
  ingredientId String?
  ingredient   Ingredient?   @relation(fields: [ingredientId], references: [id])
  locationId   String
  location     StockLocation @relation(fields: [locationId], references: [id])
  quantity     Decimal       @db.Decimal(12, 3)
  reason       String?
  workOrderId  String?
  workOrder    WorkOrder?    @relation(fields: [workOrderId], references: [id])
  orderId      String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([tenantId])
  @@index([partId])
  @@index([ingredientId])
  @@index([locationId])
}

model DiningTable {
  id         String    @id @default(cuid())
  tenantId   String
  tenant     Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  locationId String?
  location   Location? @relation(fields: [locationId], references: [id])
  name       String
  seats      Int       @default(2)
  posX       Float     @default(0.1)
  posY       Float     @default(0.1)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  orders     Order[]

  @@index([tenantId])
}

model MenuItem {
  id           String             @id @default(cuid())
  tenantId     String
  tenant       Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name         String
  category     String
  station      String
  price        Decimal            @db.Decimal(10, 2)
  available    Boolean            @default(true)
  customFields Json               @default("{}")
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  modifiers    MenuItemModifier[]
  lines        OrderLine[]

  @@index([tenantId, category])
}

model Modifier {
  id         String             @id @default(cuid())
  tenantId   String
  tenant     Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name       String
  priceDelta Decimal            @default(0) @db.Decimal(10, 2)
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt
  items      MenuItemModifier[]

  @@index([tenantId])
}

model MenuItemModifier {
  menuItemId String
  modifierId String
  tenantId   String
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  modifier   Modifier @relation(fields: [modifierId], references: [id], onDelete: Cascade)
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@id([menuItemId, modifierId])
  @@index([tenantId])
}

model Order {
  id        String       @id @default(cuid())
  tenantId  String
  tenant    Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tableId   String?
  table     DiningTable? @relation(fields: [tableId], references: [id])
  status    OrderStatus  @default(OPEN)
  covers    Int          @default(1)
  notes     String?
  payments  Json         @default("[]")
  closedAt  DateTime?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  lines     OrderLine[]

  @@index([tenantId, status])
  @@index([tableId])
}

model OrderLine {
  id         String          @id @default(cuid())
  tenantId   String
  tenant     Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  orderId    String
  order      Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItemId String?
  menuItem   MenuItem?       @relation(fields: [menuItemId], references: [id])
  name       String
  station    String
  quantity   Int             @default(1)
  unitPrice  Decimal         @db.Decimal(10, 2)
  modifiers  Json            @default("[]")
  status     OrderLineStatus @default(PENDING)
  note       String?
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  @@index([tenantId])
  @@index([orderId])
}

model Ingredient {
  id            String              @id @default(cuid())
  tenantId      String
  tenant        Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name          String
  unit          String
  sku           String?
  category      String?
  barcode       String?
  minQuantity   Decimal?            @db.Decimal(12, 3)
  unitCost      Decimal?            @db.Decimal(10, 2)
  supplierId    String?
  supplier      Supplier?           @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  movements     StockMovement[]
  purchaseLines PurchaseOrderLine[]

  @@index([tenantId, name])
  @@index([tenantId, barcode])
  @@index([supplierId])
}

model Supplier {
  id            String          @id @default(cuid())
  tenantId      String
  tenant        Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name          String
  vat           String?
  contactName   String?
  email         String?
  phone         String?
  address       String?
  city          String?
  paymentTerms  String?
  notes         String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  orders        PurchaseOrder[]
  ledgerEntries LedgerEntry[]
  ingredients   Ingredient[]

  @@index([tenantId, name])
}

model PurchaseOrder {
  id         String              @id @default(cuid())
  tenantId   String
  tenant     Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  supplierId String
  supplier   Supplier            @relation(fields: [supplierId], references: [id])
  status     PurchaseOrderStatus @default(DRAFT)
  notes      String?
  expectedAt DateTime?
  receivedAt DateTime?
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt
  lines      PurchaseOrderLine[]

  @@index([tenantId, status])
}

model PurchaseOrderLine {
  id           String        @id @default(cuid())
  tenantId     String
  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  orderId      String
  order        PurchaseOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  ingredientId String?
  ingredient   Ingredient?   @relation(fields: [ingredientId], references: [id])
  description  String
  quantity     Decimal       @db.Decimal(12, 3)
  unitPrice    Decimal       @db.Decimal(10, 2)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([tenantId])
  @@index([orderId])
}

model Shift {
  id        String      @id @default(cuid())
  tenantId  String
  tenant    Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId    String
  user      User        @relation(fields: [userId], references: [id])
  roleLabel String?
  startsAt  DateTime
  endsAt    DateTime
  status    ShiftStatus @default(PLANNED)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([tenantId, startsAt])
  @@index([userId])
}

model LedgerEntry {
  id             String            @id @default(cuid())
  tenantId       String
  tenant         Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  kind           LedgerKind
  date           DateTime
  amount         Decimal           @db.Decimal(12, 2)
  vatRate        Decimal           @default(0) @db.Decimal(5, 2)
  category       String
  description    String?
  method         String?
  paid           Boolean           @default(true)
  customerId     String?
  customer       Customer?         @relation(fields: [customerId], references: [id], onDelete: SetNull)
  supplierId     String?
  supplier       Supplier?         @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  workOrderId    String?
  workOrder      WorkOrder?        @relation(fields: [workOrderId], references: [id], onDelete: SetNull)
  workPayment    WorkOrderPayment?
  payrollPosting PayrollPosting?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([tenantId, date])
  @@index([tenantId, kind, paid])
  @@index([customerId])
  @@index([supplierId])
  @@index([workOrderId])
}

model WorkOrderPayment {
  id             String            @id @default(cuid())
  tenantId       String
  tenant         Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  workOrderId    String            @unique
  workOrder      WorkOrder         @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  customerId     String?
  customer       Customer?         @relation(fields: [customerId], references: [id], onDelete: SetNull)
  amount         Decimal           @db.Decimal(12, 2)
  paidAmount     Decimal           @default(0) @db.Decimal(12, 2)
  status         WorkPaymentStatus @default(DUE)
  method         String?
  token          String            @unique
  note           String?
  sentEmailAt    DateTime?
  sentWhatsappAt DateTime?
  paidAt         DateTime?
  ledgerEntryId  String?           @unique
  ledgerEntry    LedgerEntry?      @relation(fields: [ledgerEntryId], references: [id], onDelete: SetNull)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([tenantId, status])
  @@index([customerId])
}

model PayrollPosting {
  id            String      @id @default(cuid())
  tenantId      String
  tenant        Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Calendar month in Europe/Rome, YYYY-MM. Rates are snapshotted so later raises do not rewrite closed months.
  month         String
  hourlyRate    Decimal     @db.Decimal(8, 2)
  overtimeRate  Decimal     @db.Decimal(8, 2)
  weeklyHours   Decimal     @db.Decimal(5, 2)
  ledgerEntryId String      @unique
  ledgerEntry   LedgerEntry @relation(fields: [ledgerEntryId], references: [id], onDelete: Cascade)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@unique([tenantId, userId, month])
  @@index([tenantId, month])
}

model Notification {
  id        String    @id @default(cuid())
  tenantId  String
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId    String?
  title     String
  body      String
  href      String?
  dedupeKey String?
  readAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([tenantId, createdAt])
  @@index([tenantId, userId, dedupeKey])
}
