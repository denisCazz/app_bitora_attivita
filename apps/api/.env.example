# PostgreSQL remoto. L'app compone la connessione da questi campi.
DB_HOST=
DB_PORT=5432
DB_USER=
DB_PASSWORD=
DB_NAME=rapportini
# require se il server usa TLS. disable solo se non ha SSL.
DB_SSL=require

JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
REDIS_URL=redis://localhost:6379
PORT=3001
# Link che il cliente apre per pagare. In produzione deve essere raggiungibile da fuori.
PUBLIC_BASE_URL=http://localhost:3001
# Pagamenti di moduli e utenti extra (5€/mese dal quarto), conto test Bitora.
# Usa una chiave ristretta (rk_test_...), non la chiave segreta.
# Permessi: Customers, Products, Prices, Checkout Sessions, Subscriptions, Billing Portal.
# Senza chiave e con BILLING_DEMO=true lo sblocco è immediato (solo sviluppo).
# STRIPE_SECRET_KEY=rk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
BILLING_DEMO=false
# Acquisti in-app nelle app iOS/Android (obbligatori per gli store): un abbonamento mensile per modulo,
# ID prodotto "bitora_module_<chiave>" (es. bitora_module_calendar), su App Store Connect e Google Play Console.
# Notifiche server: App Store Server Notifications V2 -> {PUBLIC_BASE_URL}/billing/apple/notifications
#                   Google Play RTDN (Pub/Sub push)    -> {PUBLIC_BASE_URL}/billing/google/notifications
# APPLE_BUNDLE_ID=app.bitora.mobile
# ID numerico dell'app in App Store Connect: serve per verificare gli acquisti reali (Production).
# APPLE_APP_ID=
# Sandbox/TestFlight e revisione Apple usano acquisti di prova: lasciali accettati.
# APPLE_ALLOW_SANDBOX=true
# GOOGLE_PACKAGE_NAME=app.bitora.mobile
# JSON del service account con accesso "Visualizza dati finanziari / Gestisci ordini" in Play Console.
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# GOOGLE_ALLOW_TEST_PURCHASES=true
# Accedi con Apple: basta APPLE_BUNDLE_ID. Per revocare l'accesso quando l'utente elimina l'account
# (richiesto da Apple) crea in Certificates, Identifiers & Profiles > Keys una chiave "Sign in with Apple".
# APPLE_TEAM_ID=XM8ZBP83QV
# APPLE_SIGNIN_KEY_ID=
# Contenuto del file .p8 su una riga, con \n al posto degli a capo.
# APPLE_SIGNIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# Accedi con Google: ID client OAuth (iOS, Android e Web) separati da virgola, da Google Cloud Console.
# Senza, il pulsante Google risponde "non configurato".
# GOOGLE_OAUTH_CLIENT_IDS=123-ios.apps.googleusercontent.com,123-web.apps.googleusercontent.com
# Assistente AI: usa le stesse API e gli stessi permessi dell'utente che scrive.
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_TRANSCRIBE_MODEL=whisper-1
# Voce dell'assistente: edge (gratis, senza chiave), azure (gratis fino a 500k caratteri/mese), elevenlabs, openai.
# TTS_PROVIDER=edge
# Voci italiane edge/azure: it-IT-IsabellaNeural, it-IT-ElsaNeural, it-IT-DiegoNeural, it-IT-GiuseppeMultilingualNeural
# TTS_VOICE=it-IT-IsabellaNeural
# AZURE_SPEECH_KEY=
# AZURE_SPEECH_REGION=westeurope
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=
# ELEVENLABS_MODEL=eleven_flash_v2_5
# OPENAI_TTS_MODEL=gpt-4o-mini-tts
# OPENAI_TTS_VOICE=sage
# Opzionali, per allegati su S3/R2
# S3_ENDPOINT=
# S3_BUCKET=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_REGION=auto
# Dati legali mostrati in Informativa privacy, Termini e Note legali (obbligatori prima della pubblicazione).
LEGAL_COMPANY_NAME=
LEGAL_VAT_NUMBER=
LEGAL_ADDRESS=
LEGAL_REA=
LEGAL_PEC=
LEGAL_PRIVACY_EMAIL=
# Solo se hai nominato un DPO
# LEGAL_DPO_EMAIL=
# Foro competente per i contratti con le aziende, es. Milano
LEGAL_COURT=
# Dove girano API e database, es. "Hetzner Online GmbH (Germania)"
LEGAL_HOSTING_PROVIDER=
