DATABASE_URL=postgresql://rapportini:rapportini@localhost:5433/rapportini
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
REDIS_URL=redis://localhost:6379
PORT=3001
PUBLIC_BASE_URL=http://localhost:3001
# Pagamenti dei moduli. Senza Stripe e con BILLING_DEMO=true lo sblocco è immediato (solo sviluppo).
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
BILLING_DEMO=false
# Opzionali, per allegati su S3/R2
# S3_ENDPOINT=
# S3_BUCKET=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_REGION=auto
