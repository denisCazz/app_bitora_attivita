{
  "name": "@rapportini/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "build": "tsc --noEmit",
    "postinstall": "prisma generate",
    "prisma:deploy": "tsx scripts/run-prisma.ts migrate deploy",
    "prisma:dev": "tsx scripts/run-prisma.ts migrate dev",
    "prisma:seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@apple/app-store-server-library": "^3.1.0",
    "@aws-sdk/client-s3": "^3.896.0",
    "@fastify/cors": "^11.1.0",
    "@fastify/multipart": "^9.0.3",
    "@fastify/static": "^8.2.0",
    "@prisma/client": "^6.19.3",
    "@rapportini/shared": "workspace:*",
    "bcryptjs": "^3.0.2",
    "bullmq": "^5.58.5",
    "fastify": "^5.6.1",
    "google-auth-library": "^11.1.0",
    "ioredis": "^5.8.0",
    "jose": "^6.1.0",
    "msedge-tts": "^2.0.8",
    "pdfkit": "^0.17.2",
    "qrcode": "^1.5.4",
    "stripe": "22.4.0",
    "zod": "^3.25.76",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.18.6",
    "@types/pdfkit": "^0.13.9",
    "@types/qrcode": "^1.5.6",
    "prisma": "^6.19.3",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
