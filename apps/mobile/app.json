{
  "expo": {
    "name": "Bitora",
    "slug": "bitora",
    "scheme": "bitora",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.bitora.mobile",
      "usesAppleSignIn": true,
      "config": {
        "usesNonExemptEncryption": false
      },
      "privacyManifests": {
        "NSPrivacyTracking": false,
        "NSPrivacyTrackingDomains": [],
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": [
              "CA92.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp",
            "NSPrivacyAccessedAPITypeReasons": [
              "0A2A.1",
              "3B52.1",
              "C617.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryDiskSpace",
            "NSPrivacyAccessedAPITypeReasons": [
              "85F4.1",
              "E174.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategorySystemBootTime",
            "NSPrivacyAccessedAPITypeReasons": [
              "35F9.1"
            ]
          }
        ]
      },
      "infoPlist": {
        "NSCameraUsageDescription": "Serve per fotografare l'intervento e leggere i codici dei ricambi.",
        "NSMicrophoneUsageDescription": "Serve per registrare audio e video durante l'intervento.",
        "NSPhotoLibraryUsageDescription": "Serve per allegare foto dal rullino.",
        "NSPhotoLibraryAddUsageDescription": "Serve per salvare nel rullino le foto dell'intervento."
      }
    },
    "android": {
      "package": "app.bitora.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#F3EFE7",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "CAMERA",
        "POST_NOTIFICATIONS"
      ],
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-video",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#000000",
          "image": "./assets/splash-icon.png",
          "imageWidth": 280,
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#000000",
            "image": "./assets/splash-icon.png"
          }
        }
      ],
      "expo-router",
      [
        "expo-secure-store",
        {
          "faceIDPermission": "Serve per sbloccare Bitora e proteggere l'accesso al tuo account."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Serve per sbloccare Bitora e proteggere l'accesso al tuo account."
        }
      ],
      "expo-apple-authentication",
      "expo-sharing",
      [
        "expo-camera",
        {
          "cameraPermission": "Serve per fotografare l'intervento e leggere i codici dei ricambi.",
          "microphonePermission": "Serve per registrare audio e video durante l'intervento."
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Serve per fotografare l'intervento e leggere i codici dei ricambi.",
          "microphonePermission": "Serve per registrare audio e video durante l'intervento.",
          "photosPermission": "Serve per allegare foto dal rullino."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#E25B2A"
        }
      ],
      "expo-web-browser",
      "expo-image",
      [
        "expo-audio",
        {
          "microphonePermission": "Serve per dettare i comandi all'assistente e registrare audio durante l'intervento.",
          "enableBackgroundPlayback": false
        }
      ],
      [
        "expo-maps",
        {
          "requestLocationPermission": true,
          "locationPermission": "Serve per mostrarti sulla mappa rispetto agli interventi del giorno."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Serve per mostrarti sulla mappa e trovare gli indirizzi degli interventi."
        }
      ],
      "expo-iap",
      "@react-native-community/datetimepicker"
    ],
    "extra": {
      "apiUrl": "http://localhost:3001",
      "router": {},
      "eas": {
        "projectId": "159f217c-5c1c-4f59-9b01-a0f1a81d9c5c"
      }
    }
  }
}
