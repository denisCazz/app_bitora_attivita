{
  "name": "rapportini",
  "private": true,
  "packageManager": "pnpm@10.33.4",
  "scripts": {
    "dev": "turbo dev",
    "dev:api": "pnpm --filter @rapportini/api dev",
    "dev:mobile": "pnpm --filter @rapportini/mobile start",
    "build": "turbo build",
    "typecheck": "turbo typecheck",
    "lint": "turbo lint",
    "db:up": "docker compose up -d",
    "db:migrate": "pnpm --filter @rapportini/api exec prisma migrate dev",
    "db:seed": "pnpm --filter @rapportini/api prisma:seed",
    "db:setup": "pnpm db:up && pnpm --filter @rapportini/api prisma:deploy && pnpm db:seed"
  },
  "devDependencies": {
    "turbo": "^2.5.8",
    "typescript": "^5.9.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["@prisma/client", "@prisma/engines", "esbuild", "msgpackr-extract", "prisma"]
  }
}
